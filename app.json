{
  "expo": {
    "name": "Allaine",
    "slug": "Allaine",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "allaine",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "icon": "./src/assets/LogoPNG.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/LogoPNG.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.Allaine"
    },
    "web": {
      "output": "static",
      "name": "Allaine",
      "favicon": "./src/assets/LogoPNG.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/LogoPNG.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
